table Calendar

	column Date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Date
		isKey
		formatString: dd MMM yyyy
		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

	column Week
		dataType: int64
		summarizeBy: none
		sourceColumn: Week

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: MonthNumber

	column MonthNumber
		dataType: int64
		summarizeBy: none
		sourceColumn: MonthNumber
		isHidden

	partition Calendar = m
		mode: import
		source =
			let
			    FirstYear = Date.StartOfYear(List.Min(Feedback[ResponseDate])),
			    LastYear = Date.EndOfYear(List.Max(Feedback[ResponseDate])),
			    Days = List.Dates(FirstYear, Duration.Days(LastYear - FirstYear) + 1, #duration(1,0,0,0)),
			    Source = Table.FromList(Days, Splitter.SplitByNothing(), {"Date"}),
			    Typed = Table.TransformColumnTypes(Source, {{"Date", type date}}),
			    Year = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
			    Week = Table.AddColumn(Year, "Week", each Date.WeekOfYear([Date], Day.Monday), Int64.Type),
			    Month = Table.AddColumn(Week, "Month", each Date.ToText([Date], "MMM", "en-GB"), type text),
			    MonthNumber = Table.AddColumn(Month, "MonthNumber", each Date.Month([Date]), Int64.Type)
			in
			    MonthNumber
